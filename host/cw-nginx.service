[Unit]
Description=Apply CW widget nginx injection (fetches patch.sh from the Widget Hub)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=360
# Thin shim: the patch logic itself is shipped by the container and updated via Docker.
# The hub app may not be up yet when this fires (at boot, or when an OS upgrade
# regenerates nginx.conf before Docker apps have started) — retry for up to 5 minutes.
ExecStart=/bin/sh -c 'for i in $(seq 1 60); do curl -fsS --max-time 10 http://127.0.0.1:35200/cw/patch/patch.sh -o /run/cw-patch.sh && exec sh /run/cw-patch.sh; sleep 5; done; echo "cw: Widget Hub not reachable on 127.0.0.1:35200 after 5 minutes" >&2; exit 1'
