{
  "id": "gpu-monitor",
  "name": "GPU Monitor",
  "version": "1.2.0",
  "author": "CW",
  "description": "NVIDIA GPU monitor — VRAM, clock, power, temperature and a selectable fan, each with a live history graph. Supports multiple GPUs and fans.",
  "client": "client.js",
  "supportedSizes": ["quarter", "half", "full"],
  "producer": { "cmd": ["python3", "producer.py"], "interval": 5, "outputs": ["stats.json"] },
  "config": {
    "graphs": { "type": "multi", "label": "Graphs", "options": ["vram", "clock", "power", "temp", "fan"], "default": ["vram", "clock", "power", "temp", "fan"] },
    "gpuIndex": { "type": "select", "label": "GPU", "optionsFrom": { "file": "stats.json", "path": "gpus", "value": "index", "label": "name" }, "default": 0 },
    "fanKey": { "type": "select", "label": "Fan source", "optionsFrom": { "file": "stats.json", "path": "fans", "value": "key", "label": "label" }, "default": "fan1" }
  },
  "permissions": ["nvidia", "hwmon"]
}
