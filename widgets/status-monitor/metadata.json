{
  "id": "status-monitor",
  "name": "Status Monitor",
  "version": "1.0.0",
  "author": "CW",
  "description": "Up/down + latency for a list of services. One per line: Label|https://url",
  "client": "client.js",
  "supportedSizes": ["quarter", "half", "full"],
  "config": {
    "services": { "type": "textarea", "label": "Services (Label|URL per line)", "default": "" },
    "interval": { "type": "number", "label": "Refresh seconds", "default": 30 }
  }
}
