{
  "id": "custom-api",
  "name": "Custom API",
  "version": "1.0.0",
  "author": "CW",
  "description": "Fetch any JSON API and show chosen fields. Map 'Label: path.to.value' per line.",
  "client": "client.js",
  "supportedSizes": ["quarter", "half", "full"],
  "config": {
    "url": { "type": "string", "label": "JSON URL", "default": "" },
    "headers": { "type": "textarea", "label": "Headers (Key: Value per line)", "default": "" },
    "fields": { "type": "textarea", "label": "Fields (Label: json.path per line)", "default": "" },
    "interval": { "type": "number", "label": "Refresh seconds", "default": 60 }
  }
}
