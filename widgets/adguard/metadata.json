{
  "id": "adguard",
  "name": "AdGuard Home",
  "version": "1.0.0",
  "author": "CW",
  "description": "AdGuard Home DNS stats — queries and % blocked (uses your AdGuard login).",
  "client": "client.js",
  "supportedSizes": ["quarter", "half", "full"],
  "config": {
    "url": { "type": "string", "label": "AdGuard URL", "default": "" },
    "username": { "type": "string", "label": "Username", "default": "" },
    "password": { "type": "string", "label": "Password", "default": "" },
    "interval": { "type": "number", "label": "Refresh seconds", "default": 60 }
  }
}
