{
  "id": "downloads",
  "name": "Downloads",
  "version": "1.0.0",
  "author": "CW",
  "description": "Active downloads on qBittorrent (login) or SABnzbd (API key).",
  "client": "client.js",
  "supportedSizes": ["quarter", "half", "full"],
  "config": {
    "type": { "type": "select", "label": "Client", "options": ["qbittorrent", "sabnzbd"], "default": "qbittorrent" },
    "url": { "type": "string", "label": "URL", "default": "" },
    "username": { "type": "string", "label": "Username (qBittorrent)", "default": "" },
    "password": { "type": "string", "label": "Password (qBittorrent)", "default": "" },
    "apikey": { "type": "string", "label": "API key (SABnzbd)", "default": "" },
    "interval": { "type": "number", "label": "Refresh seconds", "default": 10 }
  }
}
