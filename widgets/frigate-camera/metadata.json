{
  "id": "frigate-camera",
  "name": "Frigate Camera",
  "version": "1.0.0",
  "author": "CW",
  "description": "Live camera snapshots from Frigate, auto-refreshing. One or more camera names.",
  "client": "client.js",
  "supportedSizes": ["quarter", "half", "full"],
  "config": {
    "url": { "type": "string", "label": "Frigate URL", "default": "" },
    "cameras": { "type": "textarea", "label": "Camera names (one per line or comma-separated)", "default": "" },
    "height": { "type": "number", "label": "Snapshot height (px)", "default": 360 },
    "interval": { "type": "number", "label": "Refresh seconds", "default": 2 }
  }
}
