{
  "id": "uptime-kuma",
  "name": "Uptime Kuma",
  "version": "1.0.0",
  "author": "CW",
  "description": "Monitor states from an Uptime Kuma status page (needs the status-page slug).",
  "client": "client.js",
  "supportedSizes": ["quarter", "half", "full"],
  "config": {
    "url": { "type": "string", "label": "Uptime Kuma URL", "default": "" },
    "slug": { "type": "string", "label": "Status page slug", "default": "" },
    "interval": { "type": "number", "label": "Refresh seconds", "default": 60 }
  }
}
